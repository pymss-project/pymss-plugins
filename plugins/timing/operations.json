      "inputs": {
        "audio": {
          "type": "audio"
        }
      },
      "outputs": {
        "audio": {
          "type": "audio"
        }
      },
      "params": {
        "additionalProperties": false,
        "properties": {
          "rate": {
            "default": 1.0,
            "maximum": 4.0,
            "minimum": 0.25,
            "type": "number"
          }
        },
        "type": "object"
      },
      "schemaVersion": 1,
      "title": "Time Stretch"
    }
