{
  "formatVersion": 1,
  "operations": [
    {
      "description": "Shift pitch with Rubber Band R3 or Radius (duration preserved)",
      "id": "pymss.timing.pitch_shift",
      "inputs": {
        "audio": {
          "type": "audio"
        }
      },
      "outputs": {
        "audio": {
          "type": "audio"
        }
      },
      "params": {
        "additionalProperties": false,
        "properties": {
          "algorithm": {
            "default": "rubberband",
            "enum": [
              "rubberband",
              "radius"
            ],
            "type": "string"
          },
          "bins_per_octave": {
            "default": 12,
            "maximum": 36,
            "minimum": 1,
            "type": "integer"
          },
          "n_steps": {
            "default": 0.0,
            "maximum": 24.0,
            "minimum": -24.0,
            "type": "number"
          }
        },
        "type": "object"
      },
      "schemaVersion": 1,
      "title": "Pitch Shift"
    },
    {
      "description": "Choose a pitch algorithm; Radius requires speed 100%, Rubber Band also changes speed",
      "id": "pymss.timing.process",
      "inputs": {
        "audio": {
          "type": "audio"
        }
      },
      "outputs": {
        "audio": {
          "type": "audio"
        }
      },
      "params": {
        "additionalProperties": false,
        "properties": {
          "algorithm": {
            "default": "rubberband",
            "enum": [
              "rubberband",
              "radius"
            ],
            "type": "string"
          },
          "n_steps": {
            "default": 0.0,
            "maximum": 24.0,
            "minimum": -24.0,
            "type": "number"
          },
          "speed_percent": {
            "default": 100.0,
            "maximum": 400.0,
            "minimum": 25.0,
            "type": "number"
          }
        },
        "required": [
          "algorithm",
          "n_steps",
          "speed_percent"
        ],
        "type": "object"
      },
      "schemaVersion": 1,
      "title": "Pitch and Speed"
    },
    {
      "description": "Time-stretch with Rubber Band R3 without pitch change",
      "id": "pymss.timing.time_stretch",
      "inputs": {
        "audio": {
          "type": "audio"
        }
      },
      "outputs": {
        "audio": {
          "type": "audio"
        }
      },
      "params": {
        "additionalProperties": false,
        "properties": {
          "rate": {
            "default": 1.0,
            "maximum": 4.0,
            "minimum": 0.25,
            "type": "number"
          }
        },
        "type": "object"
      },
      "schemaVersion": 1,
      "title": "Time Stretch"
    }
  ],
