{
  "formatVersion": 1,
  "operations": [
    {
      "description": "Shift pitch with Rubber Band R3 or Radius (duration preserved)",
      "id": "pymss.timing.pitch_shift",
      "inputs": {
        "audio": {
          "type": "audio"
        }
      },
      "outputs": {
        "audio": {
          "type": "audio"
        }
      },
      "params": {
        "additionalProperties": false,
        "properties": {
          "algorithm": {
            "default": "rubberband",
            "enum": [
              "rubberband",
              "radius",
              "radius_rustfft"
            ],
            "type": "string"
          },
          "bins_per_octave": {
            "default": 12,
            "maximum": 36,
            "minimum": 1,
            "type": "integer"
          },
          "n_steps": {
            "default": 0.0,
            "maximum": 24.0,
            "minimum": -24.0,
            "type": "number"
          }
        },
        "type": "object"
      },
      "schemaVersion": 1,
      "title": "Pitch Shift"
    },
    {
      "description": "Change pitch and output duration with Radius or Rubber Band R3",
      "id": "pymss.timing.process",
      "inputs": {
        "audio": {
          "type": "audio"
        }
      },
      "outputs": {
        "audio": {
          "type": "audio"
        }
      },
      "params": {
        "additionalProperties": false,
        "properties": {
          "algorithm": {
            "default": "rubberband",
            "enum": [
              "rubberband",
              "radius",
              "radius_rustfft"
            ],
            "type": "string"
          },
          "duration_percent": {
            "default": 100.0,
            "maximum": 400.0,
            "minimum": 25.0,
            "type": "number"
          },
          "n_steps": {
            "default": 0.0,
            "maximum": 24.0,
            "minimum": -24.0,
            "type": "number"
          }
        },
        "required": [
          "algorithm",
          "n_steps",
          "duration_percent"
        ],
        "type": "object"
      },
      "schemaVersion": 1,
      "title": "Pitch and Speed"
    },
    {
      "description": "Process an audio file and save a named WAV in the selected output directory",
      "id": "pymss.timing.process_file",
      "inputs": {
        "audio": {
          "type": "file"
        }
      },
      "outputs": {
        "audio": {
          "media_type": "audio/wav",
          "type": "file"
        }
      },
      "params": {
        "additionalProperties": false,
        "properties": {
          "algorithm": {
            "default": "rubberband",
            "enum": [
              "rubberband",
              "radius",
              "radius_rustfft"
            ],
            "type": "string"
          },
          "duration_percent": {
            "default": 100.0,
            "maximum": 400.0,
            "minimum": 25.0,
            "type": "number"
          },
          "n_steps": {
            "default": 0.0,
            "maximum": 24.0,
            "minimum": -24.0,
            "type": "number"
          }
        },
        "required": [
          "algorithm",
          "n_steps",
          "duration_percent"
        ],
        "type": "object"
      },
      "schemaVersion": 1,
      "title": "Process Audio File"
    },
    {
      "description": "Time-stretch with Rubber Band R3 without pitch change",
      "id": "pymss.timing.time_stretch",
      "inputs": {
        "audio": {
          "type": "audio"
        }
      },
      "outputs": {
        "audio": {
          "type": "audio"
        }
      },
      "params": {
        "additionalProperties": false,
        "properties": {
          "rate": {
            "default": 1.0,
            "maximum": 4.0,
            "minimum": 0.25,
            "type": "number"
          }
        },
        "type": "object"
      },
      "schemaVersion": 1,
      "title": "Time Stretch"
    }
  ],
